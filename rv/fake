<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>⚠️ Aviso de Segurança - Site Não Confiável</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            padding: 20px;
        }

        .redirect-container {
            background: white;
            border-radius: 24px;
            padding: 45px 40px;
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
            max-width: 820px;
            width: 100%;
            animation: slideUp 0.6s ease-out;
            max-height: 95vh;
            overflow-y: auto;
        }

        .redirect-container::-webkit-scrollbar {
            width: 6px;
        }

        .redirect-container::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        .redirect-container::-webkit-scrollbar-thumb {
            background: #dc2626;
            border-radius: 10px;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ===== HEADER COM ALERTA MÁXIMO ===== */
        .alert-header {
            background: linear-gradient(135deg, #dc2626, #b91c1c);
            color: white;
            border-radius: 16px;
            padding: 20px 25px;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            gap: 20px;
            animation: pulseAlert 2s ease-in-out infinite;
        }

        @keyframes pulseAlert {
            0%, 100% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.01);
            }
        }

        .alert-header .icon-big {
            font-size: 3rem;
            min-width: 60px;
            text-align: center;
        }

        .alert-header .alert-text h1 {
            color: white;
            font-size: 1.5rem;
            margin-bottom: 4px;
        }

        .alert-header .alert-text p {
            color: #fca5a5;
            font-size: 0.95rem;
        }

        /* ===== BADGES DE ALERTA ===== */
        .alert-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 20px;
            justify-content: center;
        }

        .badge {
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .badge-red {
            background: #fee2e2;
            color: #991b1b;
            border: 2px solid #fca5a5;
        }

        .badge-orange {
            background: #fffbeb;
            color: #92400e;
            border: 2px solid #fcd34d;
        }

        .badge-purple {
            background: #f3e8ff;
            color: #6b21a8;
            border: 2px solid #d8b4fe;
        }

        .badge-blue {
            background: #dbeafe;
            color: #1e40af;
            border: 2px solid #93c5fd;
        }

        /* ===== AVISO PRINCIPAL ===== */
        .warning-box {
            background: #fef2f2;
            border-left: 6px solid #dc2626;
            padding: 20px 22px;
            border-radius: 12px;
            margin: 15px 0;
        }

        .warning-box h3 {
            color: #991b1b;
            font-size: 1.1rem;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .warning-box ul {
            color: #7f1d1d;
            font-size: 0.92rem;
            padding-left: 22px;
            line-height: 1.8;
        }

        .warning-box ul li {
            margin-bottom: 4px;
        }

        .warning-box ul li strong {
            color: #dc2626;
        }

        /* ===== CHECKLIST DE VERIFICAÇÃO ===== */
        .checklist-box {
            background: #f0f9ff;
            border: 2px solid #bae6fd;
            border-radius: 12px;
            padding: 18px 20px;
            margin: 15px 0;
        }

        .checklist-box h4 {
            color: #0369a1;
            font-size: 0.95rem;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .checklist-box .check-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 6px 0;
            font-size: 0.88rem;
            color: #0c4a6e;
            line-height: 1.5;
        }

        .checklist-box .check-item .icon {
            font-size: 1rem;
            min-width: 24px;
            text-align: center;
        }

        .checklist-box .check-item .icon.warning {
            color: #f59e0b;
        }
        .checklist-box .check-item .icon.danger {
            color: #dc2626;
        }
        .checklist-box .check-item .icon.success {
            color: #22c55e;
        }

        /* ===== URL ===== */
        .url-box {
            background: #1f2937;
            padding: 15px 18px;
            border-radius: 10px;
            margin: 15px 0;
            word-break: break-all;
            font-family: 'Courier New', monospace;
            font-size: 0.9rem;
            color: #e5e7eb;
            border: 2px solid #374151;
        }

        .url-box .label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #9ca3af;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: block;
            margin-bottom: 5px;
        }

        .url-box .domain-highlight {
            color: #f59e0b;
            font-weight: bold;
        }

        .url-box .url-danger {
            color: #f87171;
        }

        /* ===== TERMO DE CONSENTIMENTO ===== */
        .consent-box {
            background: #1e1e2f;
            border: 2px solid #374151;
            border-radius: 12px;
            padding: 20px;
            margin: 20px 0;
        }

        .consent-box h3 {
            color: #fcd34d;
            font-size: 1rem;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .consent-box .consent-text {
            font-size: 0.85rem;
            color: #d1d5db;
            line-height: 1.8;
            max-height: 200px;
            overflow-y: auto;
            padding-right: 10px;
        }

        .consent-box .consent-text::-webkit-scrollbar {
            width: 4px;
        }

        .consent-box .consent-text::-webkit-scrollbar-thumb {
            background: #4f46e5;
            border-radius: 10px;
        }

        .consent-box .consent-text strong {
            color: #fcd34d;
        }

        .consent-box .consent-text .highlight-red {
            background: #7f1d1d;
            padding: 1px 6px;
            border-radius: 4px;
            color: #fca5a5;
        }

        .consent-box .consent-text .highlight-yellow {
            background: #78350f;
            padding: 1px 6px;
            border-radius: 4px;
            color: #fcd34d;
        }

        .consent-box .consent-text ul {
            padding-left: 20px;
            margin: 8px 0;
        }

        .consent-box .consent-text ul li {
            margin-bottom: 4px;
        }

        /* ===== CHECKBOX ===== */
        .accept-section {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            margin: 15px 0 10px;
            padding: 16px 18px;
            background: #fef2f2;
            border-radius: 10px;
            border: 2px solid #fca5a5;
            transition: all 0.3s;
        }

        .accept-section.agreed {
            border-color: #86efac;
            background: #f0fdf4;
        }

        .accept-section input[type="checkbox"] {
            width: 20px;
            height: 20px;
            min-width: 20px;
            accent-color: #22c55e;
            cursor: pointer;
            margin-top: 2px;
        }

        .accept-section label {
            color: #7f1d1d;
            font-size: 0.92rem;
            cursor: pointer;
            line-height: 1.6;
        }

        .accept-section label strong {
            color: #dc2626;
        }

        .accept-section.agreed label {
            color: #166534;
        }

        .accept-section.agreed label strong {
            color: #22c55e;
        }

        /* ===== CONTADOR ===== */
        .countdown-container {
            margin: 15px 0 5px;
            text-align: center;
        }

        .countdown {
            font-size: 2.8rem;
            font-weight: bold;
            color: #dc2626;
            display: inline-block;
            min-width: 60px;
        }

        .countdown.agreed {
            color: #22c55e;
        }

        .countdown-label {
            color: #6b7280;
            font-size: 0.9rem;
        }

        .progress-bar {
            width: 100%;
            height: 6px;
            background: #e5e7eb;
            border-radius: 3px;
            margin: 10px 0 15px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #dc2626, #f59e0b);
            border-radius: 3px;
            transition: width 1s linear;
            width: 0%;
        }

        .progress-fill.agreed {
            background: linear-gradient(90deg, #22c55e, #16a34a);
        }

        /* ===== BOTÕES ===== */
        .btn-group {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-top: 20px;
            flex-wrap: wrap;
        }

        .btn {
            padding: 14px 35px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
            color: white;
            box-shadow: 0 4px 15px rgba(220, 38, 38, 0.3);
        }

        .btn-primary:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(220, 38, 38, 0.4);
        }

        .btn-primary:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .btn-primary.agreed {
            background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
            box-shadow: 0 4px 15px rgba(34, 197, 94, 0.3);
        }

        .btn-primary.agreed:hover:not(:disabled) {
            box-shadow: 0 8px 25px rgba(34, 197, 94, 0.4);
        }

        .btn-secondary {
            background: #e5e7eb;
            color: #374151;
        }

        .btn-secondary:hover {
            background: #d1d5db;
            transform: translateY(-2px);
        }

        /* ===== INFO ===== */
        .info-box {
            margin-top: 20px;
            padding: 15px 20px;
            background: #f9fafb;
            border-radius: 12px;
            font-size: 0.78rem;
            color: #6b7280;
            border: 1px solid #e5e7eb;
            text-align: center;
        }

        .info-box i {
            color: #4f46e5;
            margin-right: 5px;
        }

        .info-box .legal-links {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 8px;
            flex-wrap: wrap;
        }

        .info-box .legal-links a {
            color: #4f46e5;
            text-decoration: none;
            font-size: 0.72rem;
        }

        .info-box .legal-links a:hover {
            text-decoration: underline;
        }

        .info-box .status-text {
            font-weight: 600;
            color: #374151;
        }

        /* ===== ERRO ===== */
        .error-box {
            background: #fee2e2;
            border: 1px solid #fca5a5;
            color: #991b1b;
            padding: 20px;
            border-radius: 12px;
            margin-top: 20px;
            text-align: center;
        }

        .error-box .icon {
            font-size: 2rem;
            display: block;
            margin-bottom: 10px;
        }

        .hidden {
            display: none !important;
        }

        /* ===== RESPONSIVO ===== */
        @media (max-width: 768px) {
            .redirect-container {
                padding: 20px 15px;
            }

            .alert-header {
                flex-direction: column;
                text-align: center;
                padding: 18px 15px;
            }

            .alert-header .alert-text h1 {
                font-size: 1.2rem;
            }

            .alert-header .alert-text p {
                font-size: 0.85rem;
            }

            .alert-badges {
                gap: 6px;
            }

            .badge {
                font-size: 0.65rem;
                padding: 5px 12px;
            }

            .warning-box {
                padding: 15px;
            }

            .warning-box ul {
                font-size: 0.85rem;
                padding-left: 18px;
            }

            .consent-box .consent-text {
                font-size: 0.8rem;
                max-height: 150px;
            }

            .btn-group {
                flex-direction: column;
            }

            .btn {
                justify-content: center;
                padding: 12px 20px;
            }

            .countdown {
                font-size: 2.2rem;
            }

            .accept-section {
                flex-direction: column;
                align-items: center;
                text-align: center;
            }

            .info-box .legal-links {
                flex-direction: column;
                gap: 4px;
            }
        }

        @media (max-width: 480px) {
            .redirect-container {
                padding: 15px 10px;
            }

            .alert-header .icon-big {
                font-size: 2rem;
                min-width: 40px;
            }

            .alert-header .alert-text h1 {
                font-size: 1rem;
            }

            .url-box {
                font-size: 0.75rem;
                padding: 10px;
            }

            .countdown {
                font-size: 1.8rem;
            }

            .checklist-box .check-item {
                font-size: 0.8rem;
            }
        }
    </style>
    <!-- Firebase SDKs -->
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js">
    </script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-firestore-compat.js">
    </script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="redirect-container" id="app">
        <!-- ===== HEADER DE ALERTA MÁXIMO ===== -->
        <div class="alert-header">
            <div class="icon-big">🚨</div>
            <div class="alert-text">
                <h1>⚠️ ATENÇÃO: SITE POTENCIALMENTE PERIGOSO</h1>
                <p>Este site pode disseminar <strong>FAKE NEWS</strong>, conter <strong>VIÉS TENDENCIOSO</strong> ou violar <strong>LEGISLAÇÕES</strong></p>
            </div>
        </div>

        <!-- ===== BADGES ===== -->
        <div class="alert-badges">
            <span class="badge badge-red"><i class="fas fa-exclamation-triangle"></i> Fake News</span>
            <span class="badge badge-orange"><i class="fas fa-balance-scale"></i> Viés Político</span>
            <span class="badge badge-purple"><i class="fas fa-gavel"></i> Violação LGPD</span>
            <span class="badge badge-blue"><i class="fas fa-newspaper"></i> Não Verificado</span>
        </div>

        <!-- ===== AVISO PRINCIPAL ===== -->
        <div class="warning-box">
            <h3><i class="fas fa-circle-exclamation"></i> MOTIVOS DE PREOCUPAÇÃO:</h3>
            <ul>
                <li>
                    <strong>📰 Fake News:</strong> Este site pode publicar <strong>informações falsas</strong> ou 
                    <strong>notícias não verificadas</strong>, comprometendo a veracidade dos fatos.
                </li>
                <li>
                    <strong>⚖️ Viés Partidário/Tendencioso:</strong> O conteúdo pode apresentar 
                    <strong>distorção deliberada</strong> dos fatos para favorecer uma narrativa específica.
                </li>
                <li>
                    <strong>🔒 Violações da LGPD:</strong> Pode coletar dados pessoais <strong>sem consentimento explícito</strong> 
                    ou compartilhá-los com terceiros de forma indevida.
                </li>
                <li>
                    <strong>🌐 Violações do Marco Civil:</strong> Pode violar a <strong>neutralidade de rede</strong> 
                    ou práticas de <strong>moderação de conteúdo</strong> inadequadas.
                </li>
                <li>
                    <strong>📊 Desinformação Organizada:</strong> Pode fazer parte de <strong>redes de desinformação</strong> 
                    ou <strong>operações de influência</strong> ilegítimas.
                </li>
            </ul>
        </div>

        <!-- ===== URL DE DESTINO ===== -->
        <div class="url-box">
            <span class="label">🌐 DESTINO SOB INVESTIGAÇÃO:</span>
            <span id="targetUrlDisplay" class="url-danger">Carregando...</span>
        </div>

        <!-- ===== CHECKLIST DE VERIFICAÇÃO ===== -->
        <div class="checklist-box">
            <h4><i class="fas fa-clipboard-list"></i> VERIFIQUE ANTES DE PROSSEGUIR:</h4>
            <div class="check-item">
                <span class="icon warning">⚠️</span>
                <span><strong>Fontes:</strong> O site cita fontes confiáveis e verificáveis?</span>
            </div>
            <div class="check-item">
                <span class="icon danger">🔴</span>
                <span><strong>Transparência:</strong> O site informa claramente sua propriedade e financiamento?</span>
            </div>
            <div class="check-item">
                <span class="icon danger">🔴</span>
                <span><strong>Histórico:</strong> Este site já foi identificado como disseminador de fake news?</span>
            </div>
            <div class="check-item">
                <span class="icon warning">⚠️</span>
                <span><strong>Política de Privacidade:</strong> O site possui política de privacidade clara e acessível?</span>
            </div>
            <div class="check-item">
                <span class="icon danger">🔴</span>
                <span><strong>Coleta de Dados:</strong> O site coleta dados sensíveis sem consentimento explícito?</span>
            </div>
            <div class="check-item">
                <span class="icon warning">⚠️</span>
                <span><strong>Correção de Erros:</strong> O site corrige publicamente informações falsas publicadas?</span>
            </div>
            <div class="check-item">
                <span class="icon danger">🔴</span>
                <span><strong>Publicidade Enganosa:</strong> O site utiliza anúncios ou patrocínios não identificados?</span>
            </div>
        </div>

        <!-- ===== TERMO DE CONSENTIMENTO ===== -->
        <div class="consent-box">
            <h3><i class="fas fa-gavel"></i> TERMO DE RESPONSABILIDADE E CIÊNCIA</h3>
            <div class="consent-text">
                <p>
                    <strong>📌 Com base na Lei Geral de Proteção de Dados (LGPD - Lei 13.709/2018) e no Marco Civil da Internet (Lei 12.965/2014):</strong>
                </p>
                <br>
                <p>
                    <strong>1. Ciência dos Riscos:</strong> Declaro que fui <span class="highlight-red">DEVIDAMENTE ALERTADO</span> 
                    sobre os potenciais riscos do site de destino, incluindo:
                </p>
                <ul>
                    <li>📰 <strong>Fake News</strong> e desinformação</li>
                    <li>⚖️ <strong>Viés tendencioso</strong> e manipulação de fatos</li>
                    <li>🔒 <strong>Coleta indevida de dados</strong> (violação LGPD)</li>
                    <li>🌐 <strong>Práticas antiéticas</strong> de moderação de conteúdo</li>
                </ul>
                <br>
                <p>
                    <strong>2. Isenção Total de Responsabilidade:</strong> O site <span class="highlight-yellow">wzzm-ce3fc.firebaseapp.com</span> 
                    <strong>NÃO SE RESPONSABILIZA</strong> por quaisquer danos, prejuízos, violações de dados ou 
                    <strong>impactos negativos decorrentes do consumo de conteúdo</strong> do site de destino.
                </p>
                <br>
                <p>
                    <strong>3. Consentimento Livre e Esclarecido:</strong> Ao marcar a opção abaixo, declaro que:
                </p>
                <ul>
                    <li>✅ Fui <strong>informado sobre os riscos</strong> de acessar um site potencialmente perigoso;</li>
                    <li>✅ Estou ciente de que o site pode conter <strong>informações falsas ou manipuladas</strong>;</li>
                    <li>✅ <strong>Isento</strong> este site de qualquer responsabilidade por danos morais, materiais ou legais;</li>
                    <li>✅ Estou ciente de que <strong>meus dados podem ser coletados indevidamente</strong> pelo destino;</li>
                    <li>✅ Tenho plena consciência de que o site <strong>não foi verificado</strong> por nossa equipe;</li>
                    <li>✅ Comprometo-me a <strong>verificar as informações</strong> em fontes confiáveis antes de compartilhá-las.</li>
                </ul>
                <br>
                <p>
                    <strong>4. Registro de Consentimento:</strong> Este ato será registrado em nosso banco de dados 
                    para <strong>conformidade legal</strong> e comprovação de consentimento, conforme art. 8º da LGPD.
                </p>
                <br>
                <p style="font-size:0.8rem;color:#9ca3af;">
                    <i class="fas fa-info-circle"></i> <strong>IP registrado:</strong> Seu endereço IP será anonimizado 
                    e armazenado apenas para fins de <strong>segurança e auditoria legal</strong>.
                </p>
            </div>
        </div>

        <!-- ===== ACEITE ===== -->
        <div class="accept-section" id="acceptSection">
            <input type="checkbox" id="consentCheck">
            <label for="consentCheck">
                <strong>LI E CONCORDO</strong> com o termo de consentimento. Estou ciente de que este site 
                <strong>PODE CONTER FAKE NEWS</strong>, <strong>VIÉS TENDENCIOSO</strong> e possíveis 
                <strong>VIOLAÇÕES LEGAIS</strong>. Assumo <strong>TOTAL RESPONSABILIDADE</strong> pelo acesso.
            </label>
        </div>

        <!-- ===== CONTADOR ===== -->
        <div class="countdown-container">
            <span class="countdown-label">⏳ Redirecionando em</span>
            <div class="countdown" id="countdown">20</div>
            <span class="countdown-label">segundos</span>
        </div>

        <div class="progress-bar">
            <div class="progress-fill" id="progressFill"></div>
        </div>

        <!-- ===== BOTÕES ===== -->
        <div class="btn-group">
            <button id="redirectBtn" class="btn btn-primary" disabled>
                <i class="fas fa-external-link-alt"></i> Prosseguir (Sob Minha Responsabilidade)
            </button>
            <button onclick="history.back()" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Voltar (Recomendado)
            </button>
        </div>

        <!-- ===== INFORMAÇÕES ADICIONAIS ===== -->
        <div class="info-box">
            <p>
                <i class="fas fa-shield-alt"></i>
                Este alerta está sendo registrado para <strong>conformidade legal e proteção do usuário</strong>.
                <br>
                <small>
                    ID: <span id="redirectId">-</span> | 
                    Status: <span class="status-text" id="statusText">Aguardando consentimento</span>
                </small>
            </p>
            <div class="legal-links">
                <a href="#" onclick="alert('LGPD - Lei 13.709/2018: Proteção de Dados Pessoais')">
                    <i class="fas fa-balance-scale"></i> LGPD
                </a>
                <a href="#" onclick="alert('Marco Civil da Internet - Lei 12.965/2014')">
                    <i class="fas fa-internet-explorer"></i> Marco Civil
                </a>
                <a href="#" onclick="alert('Lei de Combate à Desinformação - Projeto de Lei 2630/2020')">
                    <i class="fas fa-newspaper"></i> PL 2630/2020
                </a>
                <a href="#" onclick="alert('Código de Defesa do Consumidor - Lei 8.078/1990')">
                    <i class="fas fa-shopping-cart"></i> CDC
                </a>
            </div>
        </div>

        <!-- ===== ERRO ===== -->
        <div id="errorBox" class="error-box hidden">
            <span class="icon">❌</span>
            <p id="errorMessage">Erro ao carregar o redirecionamento.</p>
        </div>
    </div>

    <script>
        // ============================================================
        // CONFIGURAÇÃO DO FIREBASE
        // ============================================================
        const firebaseConfig = {
            apiKey: "AIzaSyB9GkSqTIZ0kbVsba_WOdQeVAETrF9qna0",
            authDomain: "wzzm-ce3fc.firebaseapp.com",
            projectId: "wzzm-ce3fc",
            storageBucket: "wzzm-ce3fc.appspot.com",
            messagingSenderId: "249427877153",
            appId: "1:249427877153:web:0e4297294794a5aadeb260",
            measurementId: "G-PLKNZNFCQ8"
        };

        firebase.initializeApp(firebaseConfig);
        const db = firebase.firestore();

        // ============================================================
        // VARIÁVEIS
        // ============================================================
        let redirectId = null;
        let targetUrl = '';
        let formattedUrl = '';
        let domain = '';
        let consentGiven = false;
        let countdownInterval = null;
        let isRedirecting = false;
        let countdownValue = 20;
        const DELAY_TIME = 20;

        // ============================================================
        // FUNÇÕES
        // ============================================================

        function getUrlParameter(name) {
            name = name.replace(/[[]/, '\\[').replace(/[\]]/, '\\]');
            const regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
            const results = regex.exec(location.search);
            return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
        }

        function extractDomain(url) {
            try {
                const parsed = new URL(url);
                return parsed.hostname.replace('www.', '');
            } catch {
                return url;
            }
        }

        function isValidUrl(url) {
            try {
                new URL(url);
                return true;
            } catch {
                return false;
            }
        }

        function formatUrl(url) {
            if (!/^https?:\/\//i.test(url)) {
                return 'https://' + url;
            }
            return url;
        }

        function showError(message) {
            const errorBox = document.getElementById('errorBox');
            const errorMsg = document.getElementById('errorMessage');
            errorBox.classList.remove('hidden');
            errorMsg.textContent = message;
            document.getElementById('countdown').textContent = '⛔';
            document.getElementById('progressFill').style.width = '100%';
            document.getElementById('redirectBtn').disabled = true;
            document.getElementById('redirectBtn').innerHTML = '<i class="fas fa-times"></i> Erro';
            document.getElementById('statusText').textContent = '❌ Erro: ' + message;
        }

        async function getIpHash() {
            try {
                const response = await fetch('https://api.ipify.org?format=json');
                const data = await response.json();
                const ip = data.ip;
                const encoder = new TextEncoder();
                const data2 = encoder.encode(ip + 'wazzim-salt-2024-fakenews');
                const hashBuffer = await crypto.subtle.digest('SHA-256', data2);
                const hashArray = Array.from(new Uint8Array(hashBuffer));
                const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
                return hashHex.substring(0, 16);
            } catch {
                return 'unknown';
            }
        }

        // ============================================================
        // FUNÇÃO PRINCIPAL
        // ============================================================

        async function initRedirectWarning() {
            // 1. Obter URL
            targetUrl = getUrlParameter('uid') || getUrlParameter('url');

            if (!targetUrl) {
                showError('Nenhum destino especificado. Use ?uid=URL');
                return;
            }

            if (!isValidUrl(targetUrl) && !targetUrl.includes('.')) {
                showError('URL de destino inválida: "' + targetUrl + '"');
                return;
            }

            formattedUrl = formatUrl(targetUrl);
            domain = extractDomain(formattedUrl);

            // 2. Exibir URL
            document.getElementById('targetUrlDisplay').textContent = formattedUrl;

            // 3. Gerar ID
            redirectId = 'fn_' + Date.now().toString(36) + '_' + Math.random().toString(36).substr(2, 6);
            document.getElementById('redirectId').textContent = redirectId;

            // 4. Registrar no Firebase
            try {
                const docData = {
                    targetUrl: formattedUrl,
                    domain: domain,
                    userAgent: navigator.userAgent,
                    timestamp: firebase.firestore.FieldValue.serverTimestamp(),
                    referrer: document.referrer || 'direct',
                    ipHash: await getIpHash(),
                    status: 'pending',
                    consentGiven: false,
                    consentTimestamp: null,
                    alertType: 'fake_news_risk',
                    riskFlags: {
                        fakeNews: true,
                        politicalBias: true,
                        lgpdViolation: true,
                        marcoCivilViolation: true
                    }
                };

                await db.collection('redirectwarning').doc(redirectId).set(docData);
                console.log('✅ Alerta de Fake News registrado:', redirectId);
            } catch (error) {
                console.error('❌ Erro ao salvar:', error);
            }

            // 5. Elementos
            const consentCheck = document.getElementById('consentCheck');
            const redirectBtn = document.getElementById('redirectBtn');
            const countdownElement = document.getElementById('countdown');
            const progressFill = document.getElementById('progressFill');
            const acceptSection = document.getElementById('acceptSection');
            const statusText = document.getElementById('statusText');

            countdownValue = DELAY_TIME;
            countdownElement.textContent = countdownValue;

            // ===== REDIRECIONAR =====
            async function performRedirect() {
                if (isRedirecting) return;
                isRedirecting = true;

                try {
                    await db.collection('redirectwarning').doc(redirectId).update({
                        status: 'redirected',
                        redirectedAt: firebase.firestore.FieldValue.serverTimestamp(),
                        consentGiven: true,
                        consentTimestamp: firebase.firestore.FieldValue.serverTimestamp()
                    });
                } catch (error) {
                    console.error('Erro ao atualizar status:', error);
                }

                window.location.href = formattedUrl;
            }

            // ===== ATUALIZAR CONTADOR =====
            function updateCountdown() {
                countdownValue--;
                countdownElement.textContent = countdownValue;
                const progress = ((DELAY_TIME - countdownValue) / DELAY_TIME) * 100;
                progressFill.style.width = progress + '%';

                if (countdownValue <= 0) {
                    clearInterval(countdownInterval);
                    countdownInterval = null;
                    countdownElement.textContent = '⏳';
                    document.querySelector('.countdown-label').textContent = 'Aguardando confirmação';

                    if (consentGiven) {
                        performRedirect();
                    } else {
                        statusText.textContent = '⏸ Aguardando consentimento obrigatório';
                        redirectBtn.disabled = true;
                        redirectBtn.innerHTML = '<i class="fas fa-exclamation-triangle"></i> ACEITE OS TERMOS';
                        progressFill.style.width = '100%';
                        acceptSection.style.borderColor = '#dc2626';
                    }
                }
            }

            // ===== EVENTO CHECKBOX =====
            consentCheck.addEventListener('change', function() {
                consentGiven = this.checked;

                if (this.checked) {
                    acceptSection.classList.add('agreed');
                    acceptSection.style.borderColor = '#86efac';

                    redirectBtn.disabled = false;
                    redirectBtn.classList.add('agreed');
                    redirectBtn.innerHTML = '<i class="fas fa-check-circle"></i> Prosseguir (Sob Minha Responsabilidade)';

                    statusText.textContent = '✅ Consentimento registrado';
                    document.getElementById('countdown').classList.add('agreed');
                    progressFill.classList.add('agreed');

                    // Registrar consentimento
                    db.collection('redirectwarning').doc(redirectId).update({
                        consentGiven: true,
                        consentTimestamp: firebase.firestore.FieldValue.serverTimestamp(),
                        status: 'confirmed'
                    }).catch(err => console.error('Erro ao registrar consentimento:', err));

                    // Se já passou o tempo, redireciona
                    if (countdownValue <= 0) {
                        performRedirect();
                    } else if (!countdownInterval) {
                        // Reinicia contagem com 5 segundos
                        document.querySelector('.countdown-label').textContent = 'Redirecionando em';
                        countdownValue = Math.min(countdownValue, 5);
                        countdownElement.textContent = countdownValue;
                        countdownInterval = setInterval(updateCountdown, 1000);
                    }

                } else {
                    acceptSection.classList.remove('agreed');
                    acceptSection.style.borderColor = '#fca5a5';

                    redirectBtn.disabled = true;
                    redirectBtn.classList.remove('agreed');
                    redirectBtn.innerHTML = '<i class="fas fa-exclamation-triangle"></i> ACEITE OS TERMOS';

                    statusText.textContent = '⏸ Consentimento não dado';
                    document.getElementById('countdown').classList.remove('agreed');
                    progressFill.classList.remove('agreed');

                    if (countdownInterval) {
                        clearInterval(countdownInterval);
                        countdownInterval = null;
                        document.querySelector('.countdown-label').textContent = '⏸ Pausado';
                        countdownElement.textContent = '⏸';
                    }
                }
            });

            // ===== BOTÃO CONTINUAR =====
            redirectBtn.addEventListener('click', function(e) {
                e.preventDefault();
                if (!consentGiven) {
                    acceptSection.style.borderColor = '#dc2626';
                    acceptSection.style.background = '#fef2f2';
                    consentCheck.focus();
                    setTimeout(() => {
                        acceptSection.style.borderColor = '#fca5a5';
                        acceptSection.style.background = '#fef2f2';
                    }, 2000);
                    return;
                }
                if (countdownInterval) {
                    clearInterval(countdownInterval);
                    countdownInterval = null;
                }
                performRedirect();
            });

            // ===== INICIAR CONTAGEM =====
            progressFill.style.width = '0%';
            countdownInterval = setInterval(updateCountdown, 1000);
            statusText.textContent = '⏳ Aguardando consentimento';

            // ===== PREVENIR SAÍDA =====
            window.addEventListener('beforeunload', function(e) {
                if (!isRedirecting && consentGiven) {
                    e.preventDefault();
                    e.returnValue = 'Você está prestes a acessar um site não confiável. Deseja continuar?';
                }
            });

            console.log('✅ Sistema de alerta contra Fake News inicializado');
        }

        // ============================================================
        // INICIAR
        // ============================================================

        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(initRedirectWarning, 150);
        });
    </script>
</body>
</html>
